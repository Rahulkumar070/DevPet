# This is a template for .env.local
# Copy this file to .env.local and fill in your actual values

# ═══════════════════════════════════════════════════════════════════
# LOCAL APP AND GITHUB SIGN-IN
# ═══════════════════════════════════════════════════════════════════

# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=PUT_YOUR_SECRET_HERE

# For local dev, keep as-is
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local: mongodb://127.0.0.1:27017/devpet
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/devpet
MONGODB_URI=mongodb://127.0.0.1:27017/devpet

# Create OAuth app: https://github.com/settings/developers
# Callback: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=PUT_YOUR_CLIENT_ID
GITHUB_CLIENT_SECRET=PUT_YOUR_CLIENT_SECRET

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=PUT_YOUR_64_CHAR_HEX_KEY_HERE

# ═══════════════════════════════════════════════════════════════════
# OPTIONAL - App works fine without these
# ═══════════════════════════════════════════════════════════════════

# Redis (uses in-memory fallback if not set)
REDIS_URL=

# Email (disabled if not set)
RESEND_API_KEY=

# VAPID keys for PWA push (generate: npm run generate:vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Optional bind settings for the custom Node server
# HOST=127.0.0.1
# PORT=3000
# AI chat (get a key at https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Optional GitHub App for confirmed pushes (separate from OAuth login)
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=
