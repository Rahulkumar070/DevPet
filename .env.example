# ════════════════════════════════════════════
# DevPet — Veteran Edition · .env.local
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.
# ════════════════════════════════════════════

# ── NEXTAUTH ─────────────────────────────────────────────────────────────────
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# ── GITHUB OAUTH ─────────────────────────────────────────────────────────────
# Create at: https://github.com/settings/developers → OAuth Apps
# Callback URL: http://localhost:3000/api/auth/callback/github
# Scopes requested by DevPet: read:user, user:email
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ── MONGODB ──────────────────────────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/devpet
# Atlas:  mongodb+srv://<user>:<pass>@cluster.mongodb.net/devpet
MONGODB_URI=mongodb://127.0.0.1:27017/devpet

# ── ANTHROPIC ────────────────────────────────────────────────────────────────
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── REDIS ────────────────────────────────────────────────────────────────────
# Optional — app falls back to in-memory cache if not set.
# Local: redis://localhost:6379   Upstash: rediss://:password@host:6380
REDIS_URL=

# ── RESEND (email) ───────────────────────────────────────────────────────────
# Get key at: https://resend.com/api-keys
# Optional — email sending is skipped gracefully if not set.
RESEND_API_KEY=

# ── WEB PUSH / PWA ───────────────────────────────────────────────────────────
# Generate: npm run generate:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── ENCRYPTION ───────────────────────────────────────────────────────────────
# AES-256-GCM key for encrypting GitHub tokens in MongoDB.
# Must be exactly 64 hex characters (32 bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_char_hex_key_here

# ── APP URL ──────────────────────────────────────────────────────────────────
# Public-facing URL. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional bind settings for the custom Node server
# HOST=127.0.0.1
# PORT=3000

# Optional GitHub App for confirmed pushes (separate from OAuth login)
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=
